# Course content and per-course memory (user data, not source)
Courses/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Local storage / secrets
.env
*.local
.DS_Store

# Build artifacts
dist/
build/

# Frontend dependencies. The BUILT output in web/assets and web/index.html is
# committed on purpose: the backend serves web/ directly and app/ is frozen, so
# a checkout without a build would serve nothing.
node_modules/

# The copy of the interface inside the app bundle. `build-app.sh` makes it from
# web/ on every build, and its asset names are content-hashed, so tracking it
# churns a hundred files per rebuild for no benefit. web/ is the source of truth.
Lecture Companion.app/Contents/Resources/web/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Internal working files (agent scaffolding, not product)
.internal/
